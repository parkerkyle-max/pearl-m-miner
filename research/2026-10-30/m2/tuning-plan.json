{
  "name": "tuning-v1",
  "phases": [
    {
      "name": "cert3-selftest",
      "args": [
        "@PY",
        "-m",
        "pearl_metal_miner.miner",
        "--self-test",
        "--cpu-threads",
        "2",
        "--no-notify",
        "--no-dashboard"
      ],
      "cwd": "@ROOT/upstream-cert3",
      "timeout": 180
    },
    {
      "name": "cert3-control-a",
      "args": [
        "@PY",
        "-m",
        "pearl_metal_miner.miner",
        "--benchmark",
        "--benchmark-seconds",
        "120",
        "--m",
        "8192",
        "--n",
        "8192",
        "--cpu-threads",
        "2",
        "--no-notify",
        "--no-dashboard"
      ],
      "cwd": "@ROOT/upstream-cert3",
      "timeout": 200
    },
    {
      "name": "auto-control-a",
      "args": [
        "@PY",
        "-m",
        "pearl_m_miner.cli",
        "benchmark",
        "--seconds",
        "45",
        "--m",
        "8192",
        "--n",
        "16384",
        "--region-rows",
        "512"
      ],
      "timeout": 100
    },
